# Public Supabase project credentials (Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ or expose them to the browser.
# Service role key (Settings -> API -> service_role) used by the admin API routes to
# bypass Row Level Security when locking events, recording answers and updating the
# leaderboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared secret used to gate access to /admin. Choose a long random string.
ADMIN_KEY=change-me-to-a-long-random-secret
